# Copy to .env.local and fill values there. Never commit real credentials.
# Server-only: never rename these with a VITE_ prefix.
GEMINI_API_KEY=
GROQ_API_KEY=

# A submission endpoint, not a secret API key. Protect it in Formspree's dashboard.
FORMSPREE_LINK=

# Set true only after confirming Gemini and Groq are on their free plans.
# These are server-only switches. False uses prepared portfolio answers.
CHAT_FREE_TIER_CONFIRMED=false
CHAT_AI_ENABLED=false
CHAT_ALLOWED_ORIGIN=https://zeelll.vercel.app
