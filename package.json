{
  "name": "azel-cv-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run security:check && npm run chat:knowledge",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "resume:build": "node scripts/buildResume.mjs",
    "prebuild": "npm run security:check && npm run chat:knowledge",
    "build": "npm run typecheck && vite build",
    "postbuild": "node scripts/checkSecrets.mjs --dist",
    "security:check": "node scripts/checkSecrets.mjs",
    "security:test": "node --test scripts/checkSecrets.test.mjs",
    "chat:knowledge": "node scripts/buildChatKnowledge.mjs",
    "chat:test": "node --experimental-strip-types --test server/*.test.ts",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@vercel/firewall": "^1.2.6",
    "botid": "^1.5.11",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
